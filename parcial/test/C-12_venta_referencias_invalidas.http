# C-12 · Referencias inválidas y contrato de la venta
# Antes: python seed.py
# Cliente o libro inexistente, o libro dado de baja: 409 y ninguna escritura.
# Libro repetido, renglones vacíos o un total en el cuerpo: 422.

@base = http://localhost:8000

### 0. Login del vendedor
# esperado: 200
# @name loginVendedor
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "vendedor@example.com", "password": "Secreto1234!" }

### 1. Cliente inexistente
# esperado: 409 {"detail":"No se puede registrar la venta: el cliente no existe"}
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "cliente_id": 9999,
  "renglones": [ { "libro_id": 1, "cantidad": 1 } ]
}

### 2. Libro inexistente
# esperado: 409 {"detail":"No se puede registrar la venta: el libro no existe o está dado de baja"}
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [ { "libro_id": 9999, "cantidad": 1 } ]
}

### 3. Login del administrador, para dar de baja un libro
# esperado: 200
# @name loginAdmin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "Secreto1234!" }

### 4. Baja de la Antología (id 2)
# esperado: 204
# @no-cookie-jar
DELETE {{base}}/libros/2
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### 5. Vender el libro dado de baja
# esperado: 409 {"detail":"No se puede registrar la venta: el libro no existe o está dado de baja"}
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [ { "libro_id": 2, "cantidad": 1 } ]
}

### 6. Libro repetido
# esperado: 422
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    { "libro_id": 1, "cantidad": 1 },
    { "libro_id": 1, "cantidad": 1 }
  ]
}

### 7. Sin renglones
# esperado: 422
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{ "cliente_id": 1, "renglones": [] }

### 8. El total no viaja
# esperado: 422 extra_forbidden
# @no-cookie-jar
POST {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "total": "25000.00",
  "renglones": [ { "libro_id": 1, "cantidad": 1 } ]
}

### 9. Sigue habiendo una sola venta
# esperado: 200 total 1
# @no-cookie-jar
GET {{base}}/ventas
Cookie: {{loginVendedor.response.headers.Set-Cookie}}
