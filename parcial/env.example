# Copiá este archivo a `.env` (que NO se versiona) y completá los valores.
# Sin POSTGRES_PASSWORD ni JWT_SECRET la aplicación y Alembic no arrancan.

POSTGRES_USER=postgres
# Contraseña de tu PostgreSQL local (obligatoria, sin valor por defecto)
POSTGRES_PASSWORD=
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clave de firma de los tokens (obligatoria). Generala con:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# Minutos de vida del token (y Max-Age de la cookie)
JWT_MINUTOS=30
# Rondas de bcrypt
BCRYPT_COSTO=12
# Atributo Secure de la cookie: false en local, true tras HTTPS
COOKIE_SECURE=false
# Tamaño del pool de conexiones
DB_POOL_SIZE=5
# true para ver las consultas SQL en consola
SQL_ECHO=false
